; Novaéria: O Beijo da Morte — projeto Godot 4.3
config_version=5

[application]

config/name="Novaéria: O Beijo da Morte"
config/description="RPG de ação 2.5D (HD-2D) — Livro 2 da saga Novaéria"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
limits/opengl/max_lights_per_object=16
environment/defaults/default_clear_color=Color(0.03, 0.02, 0.04, 1)
